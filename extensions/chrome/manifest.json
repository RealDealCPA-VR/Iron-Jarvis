{
  "manifest_version": 3,
  "name": "Iron Jarvis",
  "version": "1.412.0",
  "description": "Lets Iron Jarvis, running on this computer, work in the tabs you are already signed in to.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "dist/icons/icon-16.png",
    "32": "dist/icons/icon-32.png",
    "48": "dist/icons/icon-48.png",
    "128": "dist/icons/icon-128.png"
  },
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "downloads",
    "storage",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "dist/sidepanel.html"
  },
  "action": {
    "default_title": "Iron Jarvis",
    "default_icon": {
      "16": "dist/icons/icon-16.png",
      "32": "dist/icons/icon-32.png"
    }
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+J"
      },
      "description": "Open the Iron Jarvis sidebar"
    }
  }
}
