{
  "manifest_version": 3,
  "name": "Iron Jarvis",
  "version": "1.249.0",
  "description": "Lets Iron Jarvis, running on this computer, work in the tabs you are already signed in to.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "downloads",
    "storage",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "dist/sidepanel.html"
  },
  "action": {
    "default_title": "Iron Jarvis"
  }
}
