new file mode 100644
--- /dev/null
+++ b/orderdesk/points.py
@@ -0,0 +1,19 @@
+"""Loyalty points."""
+
+#: Points per whole dollar, as (numerator, denominator), by tier.
+POINTS_PER_DOLLAR = {"bronze": (1, 1), "silver": (3, 2), "gold": (2, 1)}
+
+
+def points_earned(total_cents, tier):
+    """The points an order earns: for every WHOLE dollar of ``total_cents``
+    (the total after the discount, without shipping), 1 point for bronze, 1.5
+    for silver and 2 for gold, rounded down to a whole point."""
+    if total_cents <= 0:
+        return 0
+    numerator, denominator = POINTS_PER_DOLLAR[tier]
+    return total_cents * numerator // denominator // 100
+
+
+def points_value_cents(points):
+    """What points are worth when spent: one cent each."""
+    return points
diff --git a/orderdesk/refunds.py b/orderdesk/refunds.py
new file mode 100644
--- /dev/null
+++ b/orderdesk/refunds.py
@@ -0,0 +1,13 @@
+"""Refunds and the loyalty points they take back."""
+
+
+def points_to_take_back(points_earned, refunded_cents, paid_cents):
+    """The points a refund takes back: the order's points in proportion to the
+    refunded part of what was paid, rounded UP to a whole point, and never more
+    than the order earned. ``paid_cents`` must be more than 0."""
+    if paid_cents <= 0:
+        raise ValueError("paid_cents must be more than 0")
+    if refunded_cents <= 0:
+        return 0
+    share = -(-points_earned * refunded_cents // paid_cents)
+    return min(share, points_earned)
